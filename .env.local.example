# Ganti nilai berikut sebelum menjalankan aplikasi

# --- Login admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini
SESSION_SECRET=ganti-dengan-string-acak-panjang

# --- Supabase (penyimpanan data: profil, berita, umkm, dll) ---
# Ambil dari dashboard Supabase project kamu: Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-supabase-kamu

# --- Cloudinary (penyimpanan foto yang diupload lewat admin) ---
# Ambil dari dashboard Cloudinary: cloudinary.com/console
CLOUDINARY_CLOUD_NAME=isi-cloud-name-kamu
CLOUDINARY_API_KEY=isi-api-key-kamu
CLOUDINARY_API_SECRET=isi-api-secret-kamu
